<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/device_settings">

        <ListPreference
            app:defaultValue="both"
            app:entries="@array/device_entries"
            app:entryValues="@array/device_values"
            app:iconSpaceReserved="false"
            app:key="device_types"
            app:title="@string/device_selection_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="security_type"
            app:summary="@string/summary_secured"
            app:title="@string/security_selection_title" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:isPreferenceVisible="false"
        app:key="feedback_category"
        app:title="@string/feedback_settings">

        <Preference
            app:iconSpaceReserved="false"
            app:key="rate_app"
            app:persistent="false"
            app:summary="@string/rate_app_summary"
            app:title="@string/rate_app_title" />

    </PreferenceCategory>

</PreferenceScreen>
